PORT=5001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hrm_db

# Authentication. JWT_SECRET is REQUIRED; the server refuses to start without it.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Required to create the first admin user in an empty database.
ADMIN_PASSWORD=

# Password for auto-created employee logins. If unset, a random temporary
# password is generated and returned in the create-employee response.
DEFAULT_EMPLOYEE_PASSWORD=password123

# Optional values for `npm run check:password`.
ADMIN_EMAIL=admin@hrm.com
PASSWORD_TO_VERIFY=

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Outgoing email. Leave SMTP_USER/SMTP_PASS blank to disable mail in local dev.
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
# Optional friendly From name.
MAIL_FROM_NAME=HRM System
# Optional full From address.
# MAIL_FROM=HRM System <you@gmail.com>
# Optional SMTP overrides for Mailtrap, Ethereal, Mailgun, etc.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false

# Frontend base URL used inside password setup links.
FRONTEND_URL=http://localhost:5173

# Password setup links expire after this many hours.
PASSWORD_SETUP_TOKEN_HOURS=24

# Password reset links expire after this many hours.
PASSWORD_RESET_TOKEN_HOURS=2
