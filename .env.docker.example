# Copy to .env in the repo root before: docker compose up --build
#   cp .env.docker.example .env

# --- MySQL ---
MYSQL_ROOT_PASSWORD=hrm_root_secret
MYSQL_PORT=3306
DB_NAME=hrm_db
DB_USER=hrm_user
DB_PASSWORD=hrm_pass

# --- Backend ---
BACKEND_PORT=5001
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
ADMIN_PASSWORD=password123
DEFAULT_EMPLOYEE_PASSWORD=password123
# Origins allowed by CORS (frontend URL(s))
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Frontend ---
FRONTEND_PORT=8080