PORT=5001
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=hrm_db

# Required to create the first admin user in an empty database.
ADMIN_PASSWORD=

# Optional values for `npm run check:password`.
ADMIN_EMAIL=admin@hrm.com
PASSWORD_TO_VERIFY=

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
